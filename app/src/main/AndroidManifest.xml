<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Needed for AccountManager account picker to list Google accounts -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- Android 13+ post-notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live server stats notification (foreground service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Restores the live server notification after a reboot, when enabled -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- In-app updates from GitHub Releases (sideload / tester builds only) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Allows silent self-updates via PackageInstaller (skips Play Protect "Scan app" UI) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Lets PackageInstaller claim update ownership so later self-updates stay silent -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Health Connect permissions -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />


    <!-- Allow discovery of Health Connect on Android 11+ -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Chrome Custom Tabs for Twitch device-code activation -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".DailyDashApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.DailyDash">

        <!-- Shares downloaded update APKs with the system package installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- PackageInstaller commit trampoline (Activity avoids OEM broadcast/BG limits) -->
        <activity
            android:name=".data.update.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:finishOnTaskLaunch="true" />

        <!--
            Live server stats notification.

            specialUse rather than dataSync: Android 15 caps dataSync foreground
            services at 6 hours a day, which would silently stop an always-on
            monitor mid-afternoon.
        -->
        <service
            android:name=".data.server.ServerMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously monitors user-configured SSH servers to keep the live status notification and alerts up to date" />
        </service>

        <!-- Restarts the live notification after a reboot when the user enabled it -->
        <receiver
            android:name=".data.server.ServerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Fallback open-prompt if post-install relaunch is blocked -->
        <receiver
            android:name=".data.update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.DailyDash.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Declare Health Connect data types we read -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Required activity-alias so Health Connect can resolve the permission request -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- DailyDash Home-Screen Widget — Full Dashboard -->
        <receiver
            android:name=".widget.DashboardWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dashboard_widget_info" />
        </receiver>

        <!-- DailyDash Widget — Macros & Nutrition -->
        <receiver
            android:name=".widget.MacrosWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_macros_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/macros_widget_info" />
        </receiver>

        <!-- DailyDash Widget — Health & Activity -->
        <receiver
            android:name=".widget.HealthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_health_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/health_widget_info" />
        </receiver>

        <!-- DailyDash Widget — Weather -->
        <receiver
            android:name=".widget.WeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_weather_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>

        <!-- DailyDash Widget — Calendar -->
        <receiver
            android:name=".widget.CalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_calendar_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- F1 Widget — Next Race Countdown -->
        <receiver
            android:name=".widget.F1CountdownWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_f1_countdown_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/f1_countdown_widget_info" />
        </receiver>

        <!-- F1 Widget — Championship Standings -->
        <receiver
            android:name=".widget.F1StandingsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_f1_standings_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/f1_standings_widget_info" />
        </receiver>

        <!-- F1 Widget — Race Schedule -->
        <receiver
            android:name=".widget.F1ScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_f1_schedule_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/f1_schedule_widget_info" />
        </receiver>

    </application>

</manifest>