  <color name="widget_divider">#2E2E2E</color>
  <color name="widget_text">#E4E4E4</color>
  <color name="widget_sub">#A3A3A3</color>
  <color name="widget_warn">#F1B467</color>
  <color name="widget_error">#E34671</color>

  <!-- Widget accent — same value as the in-app weather colour -->
  <color name="widget_weather">#F5B942</color>
