<?xml version="1.0" encoding="utf-8"?>
<!--
    Tilesmith, Large (4×3): a design made in the app's Tilesmith studio. One receiver per
    size so a pinned design lands at its own size; it still resizes, and the layout drops whole
    blocks rather than squeezing them. The shared worker refreshes it, so updatePeriodMillis is 0.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_tilesmith_description"
    android:previewImage="@drawable/widget_preview_tilesmith_large"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:configure="com.macrotracker.widget.settings.WidgetSettingsActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
