## Copy to local.properties and fill in values.
## local.properties is gitignored — never commit real keys.

sdk.dir=/path/to/Android/Sdk

GEMINI_API_KEY=
OPENAI_API_KEY=
# Claude (console.anthropic.com). Powers the AI tab's two chat bots.
ANTHROPIC_API_KEY=
# Optional — unused for RSS/search. Google OAuth (AuthorizationClient) powers subscription import.
YOUTUBE_API_KEY=

# YouTube Google connect (no secrets in the app):
# 1) Google Cloud Console → enable YouTube Data API v3
# 2) OAuth consent screen (External / Testing OK for personal use; add your Google account as tester)
# 3) Create OAuth client type Android:
#      package: com.macrotracker
#      SHA-1 (tester.jks): 0C:C3:12:0A:18:2C:5A:A1:8F:39:5F:11:DB:65:1C:7D:DF:33:91:6C
# Gmail and Google Tasks for Tilesmith widgets (Settings → Permissions → Google account),
# through the same Android OAuth client as YouTube, so still no secrets in the app:
# 1) Same Cloud project → APIs & Services → enable "Gmail API" and "Google Tasks API"
# 2) OAuth consent screen → Data access → add .../auth/gmail.readonly and .../auth/tasks.readonly
# 3) Publish the consent screen (In production). Unverified is fine for personal use; in Testing
#    mode Google drops the grant after 7 days and the widget asks you to connect again.

# Twitch Helix (home Live board + Connect Twitch / import follows)
# 1) https://dev.twitch.tv/console → Register Your Application (Confidential)
# 2) OAuth Redirect URL — Twitch Console requires HTTPS. Add any placeholder, e.g.:
#      https://localhost/twitch/oauth
#    (Unused at runtime — login uses Device Code Flow via twitch.tv/activate so SMS 2FA works.)
# 3) Copy Client ID + Client Secret below, then rebuild
#
# GitHub Releases: also add these as Actions secrets on the repo (Settings → Secrets):
#   TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET
# CI writes them into local.properties before assembleRelease.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# GitHub OAuth (home GitHub card — Connect GitHub via Device Code, same as Twitch)
# 1) https://github.com/settings/developers → OAuth Apps → New OAuth App
# 2) Application name: DailyDash
#    Homepage URL: https://github.com/T3lluz/MacroTracker
#    Authorization callback URL (required by GitHub, unused at runtime):
#      https://localhost/github/oauth
# 3) After creating the app, enable Device Flow if that checkbox is shown
# 4) Copy Client ID below (Client Secret is NOT needed in the APK)
# 5) Rebuild, then tap Connect GitHub on the home card
#
# GitHub Releases: add Actions secret GH_OAUTH_CLIENT_ID (OAuth App Client ID).
# GitHub forbids secrets named GITHUB_*; CI writes this as GITHUB_CLIENT_ID.
GITHUB_CLIENT_ID=

# Optional PAT fallback only. Prefer OAuth above. Runtime leftover PAT in SharedPrefs
# still works until you Disconnect. Classic scopes: repo + read:user
GITHUB_TOKEN=
